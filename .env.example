# Copy this file to .env and use unique local credentials. Never commit .env.
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-local-password
DB_NAME=crypto_etl
POSTGRES_PORT=5432

# Set true only after configuring AWS credentials outside the repository.
S3_ENABLED=false
S3_BUCKET_NAME=
AWS_DEFAULT_REGION=ap-south-1
MIN_VALID_RECORDS=1
CURRENCY=usd
LOG_LEVEL=INFO

# Airflow Configuration
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=your-secret-key-here
