# Airflow with ETL code
FROM apache/airflow:2.9.1-python3.11

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install Python packages
RUN pip install --no-cache-dir \
    "apache-airflow-providers-postgres>=5.0.0" \
    pandas==2.2.3 \
    psycopg2-binary==2.9.10 \
    python-dotenv==1.0.1 \
    requests==2.32.3

WORKDIR /opt/airflow

# ETL project lives outside AIRFLOW_HOME so that the `config` package cannot
# collide with Airflow's own $AIRFLOW_HOME/config directory.
ENV PYTHONPATH=/opt/crypto_etl

COPY --chown=airflow:airflow config/ /opt/crypto_etl/config/
COPY --chown=airflow:airflow etl/ /opt/crypto_etl/etl/
COPY --chown=airflow:airflow migrations/ /opt/crypto_etl/migrations/
COPY --chown=airflow:airflow main.py /opt/crypto_etl/main.py

# DAG definitions
COPY --chown=airflow:airflow dags/ /opt/airflow/dags/
